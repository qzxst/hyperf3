{
  "name": "hyperf/hyperf-skeleton",
  "type": "project",
  "keywords": [
    "php",
    "swoole",
    "framework",
    "hyperf",
    "microservice",
    "middleware"
  ],
  "description": "A coroutine framework that focuses on hyperspeed and flexible, specifically use for build microservices and middlewares.",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.1",
    "doctrine/dbal": "^4.2",
    "firebase/php-jwt": "^6.11",
    "google/protobuf": "^3.25",
    "grpc/grpc": "^1.57",
    "hyperf/amqp": "~3.1.0",
    "hyperf/async-queue": "^3.1",
    "hyperf/cache": "~3.1.0",
    "hyperf/command": "~3.1.0",
    "hyperf/config": "~3.1.0",
    "hyperf/constants": "~3.1.0",
    "hyperf/crontab": "^3.1",
    "hyperf/database": "~3.1.0",
    "hyperf/db-connection": "^3.1",
    "hyperf/elasticsearch": "~3.1.0",
    "hyperf/engine": "^2.10",
    "hyperf/event": "^3.1",
    "hyperf/framework": "~3.1.0",
    "hyperf/grpc-client": "~3.1.0",
    "hyperf/grpc-server": "~3.1.0",
    "hyperf/guzzle": "~3.1.0",
    "hyperf/helper": "^3.1",
    "hyperf/http-server": "~3.1.0",
    "hyperf/json-rpc": "^3.1",
    "hyperf/logger": "~3.1.0",
    "hyperf/memory": "~3.1.0",
    "hyperf/metric": "^3.1",
    "hyperf/model-cache": "~3.1.0",
    "hyperf/phar": "^3.1",
    "hyperf/process": "^3.1",
    "hyperf/redis": "~3.1.0",
    "hyperf/rpc-client": "^3.1",
    "hyperf/rpc-server": "^3.1",
    "hyperf/signal": "^3.1",
    "hyperf/swagger": "^3.1",
    "hyperf/task": "^3.1",
    "hyperf/tracer": "~3.1.0",
    "hyperf/websocket-server": "^3.1",
    "paragonie/sodium_compat": "^2.4",
    "promphp/prometheus_client_php": "^2.14",
    "pudongping/hyperf-alarm-clock": "dev-master",
    "rybakit/msgpack": "^0.9.1",
    "symfony/mime": "^7.3",
    "tokio/hyperf3-hashing": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "friendsofphp/php-cs-fixer": "^3.0",
    "hyperf/devtool": "^3.1",
    "hyperf/testing": "^3.1",
    "mockery/mockery": "^1.0",
    "pestphp/pest": "^2.36",
    "phpstan/phpstan": "^1.0",
    "swoole/ide-helper": "^5.0"
  },
  "suggest": {
    "ext-openssl": "Required to use HTTPS.",
    "ext-json": "Required to use JSON.",
    "ext-pdo": "Required to use MySQL Client.",
    "ext-pdo_mysql": "Required to use MySQL Client.",
    "ext-redis": "Required to use Redis Client."
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "App\\Service\\": "app/Service/",
      "Game\\": "app/Proto/Game/",
      "Slot\\": "app/Proto/Slot/",
      "Auth\\": "app/Proto/Auth/",
      "GPBMetadata\\": "app/Proto/GPBMetadata/"
    },
    "files": []
  },
  "autoload-dev": {
    "psr-4": {
      "HyperfTest\\": "./test/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": [],
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-autoload-dump": [
      "rm -rf runtime/container"
    ],
    "test": "co-phpunit --prepend test/bootstrap.php --colors=always",
    "cs-fix": "php-cs-fixer fix $1",
    "analyse": "phpstan analyse --memory-limit 300M",
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "php ./bin/hyperf.php start"
    ],
    "generate-proto": [
      "bash bin/generate-proto.sh"
    ],
    "validate-protoc-version": [
      "bash bin/validate-protoc-version.sh"
    ],
    "proto": [
      "bash bin/proto.sh"
    ]
  }
}
